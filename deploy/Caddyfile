{$DOMAIN} {
	encode zstd gzip

	@website path / /index.html /styles.css /site.js /favicon.svg
	handle @website {
		root * /srv
		header {
			Content-Security-Policy "default-src 'none'; style-src 'self'; script-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			Cache-Control "no-cache"
		}
		file_server
	}

	# Keep MCP, health, and other application routes on the existing auth path.
	handle {
		reverse_proxy mempalace:8765
	}
}
