{$DOMAIN} {
	encode zstd gzip

	@website path / /index.html /styles.css /site.js /favicon.svg
	handle @website {
		root * /srv
		header {
			Content-Security-Policy "default-src 'none'; style-src 'self'; script-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			Cache-Control "no-cache"
		}
		file_server
	}

	@public_api path /mcp /healthz
	handle @public_api {
		reverse_proxy gateway:8080 {
			header_up X-Real-IP {http.request.remote.host}
		}
	}
	handle {
		respond "Not found" 404
	}
}
