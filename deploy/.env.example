# Public DNS name that points to this server. Caddy obtains/renews TLS certs.
DOMAIN=knowledge.example.com

# Generate with: openssl rand -hex 32
# Clients send this as: Authorization: Bearer <token>
MEMPALACE_MCP_HTTP_TOKEN=replace-me-with-a-long-random-token

# Pinned defaults; change deliberately when upgrading.
MEMPALACE_IMAGE=ghcr.io/mempalace/mempalace:3.10.0
QDRANT_IMAGE=qdrant/qdrant:v1.19.1
CADDY_IMAGE=caddy:2-alpine
